# ─── Airflow core ───────────────────────────────────────────────
AIRFLOW_UID=50000
AIRFLOW__API__SECRET_KEY=change-me-to-a-random-string
AIRFLOW__API_AUTH__JWT_SECRET=change-me-to-a-random-string
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
_PIP_ADDITIONAL_REQUIREMENTS=

# ─── LLM classification (OpenRouter) ──────────────────────────
# Required for the paper_reuse_classification DAG.
# Sign up at https://openrouter.ai/ and create an API key.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxx

# ─── Database (only needed when running outside Docker) ───────
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=dag_data
# DB_USER=airflow
# DB_PASSWORD=airflow

# ─── API pool concurrency ────────────────────────────────────
# DANDI_PAPER_API_POOL_SLOTS=2

# ─── Full-text fetching (paper-text-fetcher) ──────────────────
# Sent to NCBI, CrossRef and Unpaywall so they can contact you about traffic.
# Unpaywall (open-access PDFs) is skipped when this is empty.
PAPER_FETCHER_CONTACT_EMAIL=you@example.org
# Optional: enables the Elsevier ScienceDirect full-text source (10.1016/ DOIs).
# ELSEVIER_API_KEY=
# Optional: where paper-text-fetcher keeps its JSON-per-DOI text cache.
# Defaults to airflow/dags/output/paper_text_fetcher inside the containers.
# PAPER_FETCHER_CACHE_DIR=
