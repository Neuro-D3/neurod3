# ─── Airflow core ───────────────────────────────────────────────
AIRFLOW_UID=50000
AIRFLOW__API__SECRET_KEY=change-me-to-a-random-string
AIRFLOW__API_AUTH__JWT_SECRET=change-me-to-a-random-string
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
_PIP_ADDITIONAL_REQUIREMENTS=

# ─── LLM classification (OpenRouter) ──────────────────────────
# Required for the paper_reuse_classification DAG.
# Sign up at https://openrouter.ai/ and create an API key.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxx

# ─── Database (only needed when running outside Docker) ───────
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=dag_data
# DB_USER=airflow
# DB_PASSWORD=airflow

# ─── API pool concurrency ────────────────────────────────────
# Concurrent API-heavy batches across ALL paper-mapping DAGs (DANDI, OpenNeuro, CRCNS, SPARC).
# Pool: paper_mapping_api_pool. Also adjustable live in the Airflow UI (Admin -> Pools).
# PAPER_MAPPING_API_POOL_SLOTS=2
# Concurrent whole-paper LLM classification batches (paper_reuse_classification DAG)
# PAPER_REUSE_CLASSIFICATION_POOL_SLOTS=2

# ─── Full-text fetching (paper-text-fetcher) ──────────────────
# Sent to NCBI, CrossRef, Unpaywall and (as mailto=) OpenAlex so they can contact you
# about traffic; OpenAlex serves identified callers from its faster polite pool.
# Unpaywall (open-access PDFs) is skipped when this is empty.
PAPER_FETCHER_CONTACT_EMAIL=you@example.org
# OpenAlex API key. Free at https://help.openalex.org/api/authentication/ . Without it,
# requests count against a small daily budget shared by everyone on your network's IP
# and are refused until midnight UTC once it is spent. Strongly recommended.
OPENALEX_API_KEY=
# Optional: a different address for OpenAlex only (defaults to the one above).
# OPENALEX_MAILTO=
# Optional: enables the Elsevier ScienceDirect full-text source (10.1016/ DOIs).
# ELSEVIER_API_KEY=
# Optional: where paper-text-fetcher keeps its JSON-per-DOI text cache.
# Defaults to /opt/airflow/output/paper_text_fetcher inside the containers
# (host: airflow/output/, next to airflow/dags/ and never inside it).
# PAPER_FETCHER_CACHE_DIR=
