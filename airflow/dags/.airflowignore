# Airflow 3 reads this file with glob syntax, where "dir/" alone does not match
# the files under it; "dir/**" does. Both forms are listed so the file also
# works under the older regex syntax.

# Ignore utility files - they are not DAGs
utils/
utils/**
__pycache__/
**/__pycache__/**
*.pyc
**/*.pyc

# DAG run artifacts written by the *_paper_mapping DAGs. Not DAGs, and large:
# a populated output/ is thousands of files, which makes every DagBag scan walk
# them. On a bind mount that scan can exceed the processor's interval, so DAGs
# never finish parsing and none appear in the UI.
output/
output/**

# Unit tests for dags/utils (pytest), not DAG files.
tests/
tests/**

# The benchmark folder's DAG is reuse_classification_benchmark_dag.py; its
# answer-key builder and tests are not DAGs.
reuse_classification_benchmark_test/build_*.py
reuse_classification_benchmark_test/test_*.py
